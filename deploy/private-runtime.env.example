# Copy outside this repository (for example /etc/kopicontext/private-runtime.env,
# mode 600). Replace placeholders through the server's secret mechanism.
POSTGRES_DB=kopi_context
POSTGRES_USER=<postgres-bootstrap-admin>
POSTGRES_PASSWORD=<long-random-bootstrap-password>

# URL-encode reserved password characters. Use distinct least-privilege roles.
MIGRATION_DATABASE_URL=postgres://<ddl-migration-role>:<password>@postgres:5432/kopi_context
DATABASE_URL=postgres://<dml-api-role>:<password>@postgres:5432/kopi_context

# Shared only by Fastify and Vercel server-side BFFs, never a browser.
PRIVATE_API_SERVICE_CREDENTIAL=<long-random-service-credential>
