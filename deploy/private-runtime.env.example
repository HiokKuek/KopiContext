# Copy outside this repository (for example /etc/kopicontext/private-runtime.env,
# mode 600). Replace placeholders through the server's secret mechanism.
POSTGRES_DB=kopi_context
POSTGRES_USER=<postgres-bootstrap-admin>
POSTGRES_PASSWORD=<long-random-bootstrap-password>
POSTGRES_MIGRATION_USER=kopi_migrator
POSTGRES_MIGRATION_PASSWORD=<long-random-migration-password>
POSTGRES_API_USER=kopi_api
POSTGRES_API_PASSWORD=<long-random-api-password>

# URL-encode reserved password characters. Use distinct least-privilege roles.
MIGRATION_DATABASE_URL=postgres://kopi_migrator:<url-encoded-migration-password>@postgres:5432/kopi_context
DATABASE_URL=postgres://kopi_api:<url-encoded-api-password>@postgres:5432/kopi_context

# Shared only by Fastify and Vercel server-side BFFs, never a browser.
PRIVATE_API_SERVICE_CREDENTIAL=<long-random-service-credential>

# Optional source-preparation worker. Do not enable the Compose
# source-preparation profile until a reviewed adapter is committed into the
# private image. This is a local `file:` URL in that image, never a network URL.
# SOURCE_PREPARATION_WORKER_ID=source-preparation-1
# SOURCE_PREPARATION_ADAPTER_MODULE=file:///app/src/platform/worker/adapters/<reviewed-provider>.ts
# SOURCE_PREPARATION_WORKER_POLL_INTERVAL_MS=1000
# SOURCE_PREPARATION_WORKER_LEASE_MS=60000
# SOURCE_PREPARATION_WORKER_MAX_ATTEMPTS=3
