# Copy outside this repository (for example /etc/kopicontext/cloudflared.env,
# mode 600). A tunnel token can run a connector: do not commit or share it.
TUNNEL_TOKEN=<Cloudflare-remotely-managed-tunnel-token>

# Discover after the private runtime has started:
# docker network ls --format '{{.Name}}' | grep kopicontext-private
KOPI_PRIVATE_API_NETWORK=kopicontext-private_private_api
