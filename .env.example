# Editor authentication is optional for public-reader development. Set every
# value only when exercising the private editor authentication route locally.
EDITOR_ALLOWED_EMAIL=<sole-editor-email>
GOOGLE_CLIENT_ID=<google-oauth-web-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-web-client-secret>
NEXTAUTH_SECRET=<long-random-secret>
NEXTAUTH_URL=http://localhost:3000

# Vercel server-only BFF values. Private database/runtime values belong in the
# external deploy/private-runtime.env file described by the deployment runbook.
PRIVATE_API_BASE_URL=https://<authenticated-private-api-origin>
PRIVATE_API_SERVICE_CREDENTIAL=<long-random-service-credential>

# Public reader catalogue. Local fixtures require this explicit opt-in; do not
# use it in deployed environments. These names deliberately lack NEXT_PUBLIC_
# because the web server is the only caller of the private API.
PUBLIC_CATALOGUE_RUNTIME_MODE=local-development
# Production only: a comma-separated manifest of published Briefing slugs.
# PUBLIC_CATALOGUE_SLUGS=how-singapores-government-works
# PRIVATE_API_BASE_URL=https://private-api.example.com
# PRIVATE_API_SERVICE_CREDENTIAL=<shared-private-service-secret>
